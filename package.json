{
  "name": "econgames",
  "version": "1.0.0",
  "description": "Interactive microeconomics simulator with animated sprites - Dr. Ian Helfrich",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "twin:data": "python3 pipeline/build_twin_data.py",
    "twin:refresh": "python3 pipeline/refresh_releases.py && python3 pipeline/build_twin_data.py",
    "twin:backtest": "vite-node scripts/twin-backtest.ts"
  },
  "keywords": [
    "economics",
    "education",
    "game",
    "simulation",
    "microeconomics"
  ],
  "author": "Dr. Ian Helfrich",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "us-atlas": "^3.0.1",
    "vite": "^5.0.11",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "phaser": "^3.70.0"
  }
}
